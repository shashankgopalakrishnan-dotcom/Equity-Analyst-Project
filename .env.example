# Copy this file to .env locally. Replace the placeholders yourself.
# The Week 1 lab expects API_KEY. Never commit .env or paste a live key into GitHub.
API_KEY=

# Required for SEC EDGAR API requests; use your name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Week 2 Lab 03: select an API model ID available to your Purdue account.
# The base URL below is Purdue GenAI Studio's documented API path. The OpenAI
# Python SDK appends /chat/completions when calling the chat completions method.
GENAI_MODEL=
GENAI_BASE_URL=https://genai.rcac.purdue.edu/api
